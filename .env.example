# Örnek ortam değişkenleri. Bu dosyayı `.env` olarak kopyalayın ve DOLDURUN.
# `.env` dosyası .gitignore ile hariç tutulur; gerçek anahtarları asla commit etmeyin.

# --- Öğretmen API (SSYZ EVREN) -------------------------------------------
# TEK ZORUNLU DEĞİŞKEN: API anahtarı.
# Yalnızca ortam değişkeni veya Kaggle Secret üzerinden; dosyaya yazmayın.
EVREN_API_KEY=

# Adres ve model kimlikleri configs/teachers.yaml içinde DOĞRULANMIŞ olarak
# hazır durur (https://evren-llmapi.ssyz.org.tr/v1, mimo-v2.6-pro, glm-5.3).
# Geçici olarak başka bir modele yönlendirmek isterseniz o dosyada
# `env:EVREN_MODEL_X` biçimini kullanıp buraya değişkeni ekleyebilirsiniz.
# EVREN_MODEL_MIMO=
# EVREN_MODEL_GLM=

# Kimliklerin hâlâ geçerli olduğunu sağlayıcının kendi listesinden doğrulayın:
#   python -m gokturk.data_generation --list-models

# --- Hugging Face (opsiyonel; gated/kapalı modeller için) ----------------
# HF_TOKEN=

# --- Kaggle ---------------------------------------------------------------
# Kaggle Secrets'a yalnızca EVREN_API_KEY ekleyip "Attach"e basmanız yeterli.
# Notebook, bu secret'ı os.environ'a aktarır; anahtarı hücreye yazmayın.
