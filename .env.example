# Örnek ortam değişkenleri. Bu dosyayı `.env` olarak kopyalayın ve DOLDURUN.
# `.env` dosyası .gitignore ile hariç tutulur; gerçek anahtarları asla commit etmeyin.

# --- Öğretmen API (SSYZ EVREN) -------------------------------------------
# API anahtarı: yalnızca ortam değişkeni veya Kaggle Secret üzerinden.
EVREN_API_KEY=

# Sunucu taban adresi. DOĞRULANMIŞ değeri sağlayıcının belgesinden kopyalayın.
# configs/teachers.yaml içinde `base_url: "env:EVREN_BASE_URL"` olarak okunur.
EVREN_BASE_URL=

# Model kimlikleri. UYDURMAYIN: sağlayıcının /models listesinden veya
# belgesinden alınan gerçek kimlikleri yazın.
EVREN_MODEL_MIMO=
EVREN_MODEL_KIMI=

# --- Hugging Face (opsiyonel; gated/kapalı modeller için) ----------------
# HF_TOKEN=

# --- Kaggle ---------------------------------------------------------------
# Kaggle Secrets üzerinden EVREN_API_KEY / EVREN_BASE_URL / EVREN_MODEL_* ekleyin.
# Notebook, bu secret'ları os.environ'a aktarır; anahtarı hücreye yazmayın.
